<Window x:Class="ShopBanHang_OfflineFirst.BaoCaoDoanhThuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:ShopBanHang_OfflineFirst"
        mc:Ignorable="d" 
        Title="THỐNG KÊ DOANH THU" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20" HorizontalAlignment="Center">
            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpTu" Width="130"/>

            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <DatePicker x:Name="dpDen" Width="130"/>

            <TextBlock Text="Chi nhánh:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cbChiNhanh" Width="150" 
          VerticalContentAlignment="Center" 
          HorizontalContentAlignment="Left">
                <ComboBoxItem Content="--- Tất cả chi nhánh ---" IsSelected="True"/>
            </ComboBox>

            <Button Content="Xem báo cáo" Margin="15,0,0,0" Width="100" Background="#1877F2" Foreground="White" Click="btnXemBaoCao_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <UniformGrid Columns="3" Margin="10,0,10,10">
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="TỔNG DOANH THU" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTongDoanhThu" Text="0 đ" FontSize="24" FontWeight="Bold" Foreground="#28A745"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="TỔNG ĐƠN HÀNG" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTongDonHang" Text="0" FontSize="24" FontWeight="Bold" Foreground="#17A2B8"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Margin="10" Padding="20" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="SẢN PHẨM ĐÃ BÁN" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="txtTongSanPham" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FFC107"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border x:Name="brdCanhBaoOffline" Background="#FFF3CD" 
                    BorderBrush="#FFEEBA" BorderThickness="1" 
                    CornerRadius="5" Margin="20,0,20,10" 
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="10,5">
                    <TextBlock Text="⚠️" Margin="0,0,10,0"/>
                    <TextBlock Text="Dữ liệu đang hiển thị tại máy này (Offline). Hãy đồng bộ để có số liệu mới nhất." 
                               Foreground="#856404" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="DANH SÁCH HÓA ĐƠN CHI TIẾT" Margin="20,10" Background="White">
            <DataGrid x:Name="dgHoaDonBaoCao"
                      d:ItemsSource="{d:DesignInstance local:BaoCaoHoaDonDTO}"
          AutoGenerateColumns="False"
          IsReadOnly="True" 
          Margin="5"
          EnableRowVirtualization="True"
          SelectionMode="Single"
          MouseDoubleClick="dgHoaDonBaoCao_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian" Binding="{Binding NgayLap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                    <DataGridTextColumn Header="Mã Hóa Đơn" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Chi Nhánh" Binding="{Binding TenChiNhanh}" Width="*"/>
                    <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TongTien, StringFormat={}{0:N0} đ}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,5,0" />
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiText}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrangThaiDongBo}">
                                        <DataTrigger.Value>
                                            <sys:Int32>0</sys:Int32>
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding TrangThaiDongBo}">
                                        <DataTrigger.Value>
                                            <sys:Int32>1</sys:Int32>
                                        </DataTrigger.Value>
                                        <Setter Property="Foreground" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
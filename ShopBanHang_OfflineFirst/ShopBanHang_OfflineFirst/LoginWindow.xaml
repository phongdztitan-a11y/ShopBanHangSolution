<Window x:Class="ShopBanHang_OfflineFirst.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ĐĂNG NHẬP HỆ THỐNG" Height="394" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F0F2F5" Margin="0,-33,0,-25">
        <StackPanel VerticalAlignment="Center" Margin="40">
            <TextBlock Text="CỬA HÀNG THỜI TRANG" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="#1877F2" Margin="0,0,0,20"/>

            <TextBlock Text="Chi nhánh:"/>
            <ComboBox x:Name="cbChiNhanh" Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center">
            </ComboBox>

            <TextBlock Text="Tài khoản:"/>
            <TextBox x:Name="txtTaiKhoan" Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center"/>

            <TextBlock Text="Mật khẩu:"/>
            <PasswordBox x:Name="txtMatKhau" Margin="0,5,0,20" Height="30" VerticalContentAlignment="Center"/>

            <Button Content="ĐĂNG NHẬP" Height="40" Background="#1877F2" Foreground="White" 
                    FontWeight="Bold" Click="BtnDangNhap_Click"/>
        </StackPanel>
    </Grid>
</Window>
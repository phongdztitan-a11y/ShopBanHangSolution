<Window x:Class="ShopBanHang_OfflineFirst.QuanLyNhanVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QUẢN LÝ TÀI KHOẢN NHÂN VIÊN" Height="500" Width="800" WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F6F8" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="THÊM NHÂN VIÊN MỚI" Grid.Column="0" Padding="10" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Tài khoản đăng nhập:" Margin="0,5,0,0" FontWeight="Bold"/>
                <TextBox x:Name="txtTaiKhoan" Height="30" Padding="5,0"/>

                <TextBlock Text="Mật khẩu:" Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBox x:Name="txtMatKhau" Height="30" Padding="5,0"/>

                <TextBlock Text="Họ và tên:" Margin="0,10,0,0" FontWeight="Bold"/>
                <TextBox x:Name="txtHoTen" Height="30" Padding="5,0"/>

                <TextBlock Text="Chi nhánh làm việc:" Margin="0,10,0,0" FontWeight="Bold"/>
                <ComboBox x:Name="cmbChiNhanh" Height="30" 
          DisplayMemberPath="TenChiNhanh" 
          SelectedValuePath="MaChiNhanh"/>

                <TextBlock Text="Vai trò:" Margin="0,10,0,0" FontWeight="Bold"/>
                <ComboBox x:Name="cmbVaiTro" Height="30">
                    <ComboBoxItem Content="Nhân viên (NV)" IsSelected="True"/>
                    <ComboBoxItem Content="Quản lý (QL)"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Button x:Name="btnThemNV" Content="Thêm" Width="70" Height="40" Background="#28A745" Foreground="White" FontWeight="Bold" Click="btnThemNV_Click"/>
                    <Button x:Name="btnSuaNV" Content="Sửa" Width="70" Height="40" Background="#FFC107" Foreground="Black" FontWeight="Bold" Margin="10,0,0,0" Click="btnSuaNV_Click" IsEnabled="False"/>
                    <Button x:Name="btnXoaNV" Content="Xóa" Width="70" Height="40" Background="#DC3545" Foreground="Black" FontWeight="Bold" Margin="10,0,0,0" Click="btnXoaNV_Click" IsEnabled="False"/>
                </StackPanel>
                <Button x:Name="btnLamMoi" Content="Hủy chọn / Làm mới" Height="30" Margin="0,10,0,0" Background="#6C757D" Foreground="White" Click="btnLamMoi_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="DANH SÁCH NHÂN VIÊN THUỘC CHI NHÁNH" Grid.Column="1" Padding="10">
            <DataGrid x:Name="dgNhanVien" SelectionChanged="dgNhanVien_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tài khoản" Binding="{Binding TaiKhoan}" Width="1.5*"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="2*"/>
                    <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}" Width="1*"/>
                    <DataGridTextColumn Header="Chi nhánh" Binding="{Binding MaChiNhanh}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
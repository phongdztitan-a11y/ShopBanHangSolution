<Window x:Class="ShopBanHang_OfflineFirst.QuanLyChiNhanhWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hệ thống chi nhánh" Height="450" Width="500" WindowStartupLocation="CenterOwner">

    <Border Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Mã chi nhánh (Viết liền, không dấu):" Margin="0,5"/>
                <TextBox x:Name="txtMaCN" Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Text="Tên chi nhánh:" Margin="0,10,0,5"/>
                <TextBox x:Name="txtTenCN" Height="30" VerticalContentAlignment="Center"/>

                <UniformGrid Columns="2" Margin="0,15,0,10">
                    <Button Content="TẠO MỚI" Height="35" Margin="0,0,5,0"
                Background="#1877F2" Foreground="White" FontWeight="Bold" Click="btnLuu_Click"/>

                    <Button Content="XÓA CHỌN" Height="35" Margin="5,0,0,0"
                Background="#FF4D4D" Foreground="White" FontWeight="Bold" Click="btnXoa_Click"/>
                </UniformGrid>
            </StackPanel>
            <DataGrid Grid.Row="1" x:Name="dgChiNhanh" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã CN" Binding="{Binding MaChiNhanh}" Width="100"/>
                    <DataGridTextColumn Header="Tên Chi Nhánh" Binding="{Binding TenChiNhanh}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
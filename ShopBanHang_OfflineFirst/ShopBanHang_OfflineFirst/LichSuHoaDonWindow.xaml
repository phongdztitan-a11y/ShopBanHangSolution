<Window x:Class="ShopBanHang_OfflineFirst.LichSuHoaDonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LỊCH SỬ HÓA ĐƠN" Height="600" Width="823" WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17A2B8" Padding="10">
            <TextBlock Text="QUẢN LÝ LỊCH SỬ HÓA ĐƠN" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
            <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtTimKiemHĐ" Width="180" Height="28" VerticalContentAlignment="Center" 
                 ToolTip="Nhập mã hóa đơn..." TextChanged="txtTimKiemHĐ_TextChanged"/>

            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <DatePicker x:Name="dpTuNgay" Width="120"/>

            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker x:Name="dpDenNgay" Width="120"/>

            <Button x:Name="btnLoc" Content="Lọc dữ liệu" Width="80" Margin="10,0,0,0" 
                Background="#28A745" Foreground="White" Click="btnLoc_Click"/>

            <Button x:Name="btnLamMoi" Content="Làm mới" Width="80" Margin="5,0,0,0" 
                Click="btnLamMoi_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgHoaDon" Grid.Row="2" Margin="10,0,10,10"
          AutoGenerateColumns="False" 
          IsReadOnly="True" 
          SelectionMode="Single"
          MouseDoubleClick="dgLichSuHoaDon_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHoaDon}" Width="160"/>
                <DataGridTextColumn Header="Ngày Lập" Binding="{Binding NgayLap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150"/>

                <DataGridTextColumn Header="Chi Nhánh" Binding="{Binding MaChiNhanh}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#17A2B8"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TongTien, StringFormat={}{0:N0} đ}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Đồng bộ" Binding="{Binding TrangThaiDongBoText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
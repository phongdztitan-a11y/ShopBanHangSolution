<Window x:Class="ShopBanHang_OfflineFirst.ChiTietHoaDonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CHI TIẾT HÓA ĐƠN" Height="600" Width="700" WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="grdInNoiDung" Grid.Row="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Image x:Name="imgBarcodeHoaDon" Width="250" Height="50" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <TextBlock x:Name="txtMaHoaDon" 
               Text="MÃ ĐƠN HÀNG: HD00000" 
               FontWeight="Bold" 
               FontSize="18" 
               HorizontalAlignment="Center" 
               Foreground="Black"/>

                <Separator Margin="0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtTenKhach" Text="Khách hàng: ..."/>
                        <TextBlock x:Name="txtSdtKhach" Text="SĐT: ..."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="txtNgayTao" Text="Ngày bán: ..."/>
                        <TextBlock x:Name="txtNhanVien" Text="Người bán: ..."/>
                        <TextBlock x:Name="txtChiNhanh" Text="Chi nhánh: ..." FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <DataGrid x:Name="dgChiTiet" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SKU" Binding="{Binding SKU}" Width="110"/>
                    <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSanPham}" Width="*"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="50"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="100"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtTongTien" Grid.Row="2" Text="TỔNG CỘNG: 0 đ"
                       HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="Red" Margin="0,10,0,0"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnIn" Content="🖨 IN HÓA ĐƠN" Width="120" Height="35"
                    Background="#007BFF" Foreground="White" FontWeight="Bold"
                    Click="btnIn_Click"/>
            <Button Content="ĐÓNG" Width="80" Height="35" Margin="10,0,0,0"
                    IsCancel="True" Click="btnDong_Click"/>
        </StackPanel>
    </Grid>
</Window>
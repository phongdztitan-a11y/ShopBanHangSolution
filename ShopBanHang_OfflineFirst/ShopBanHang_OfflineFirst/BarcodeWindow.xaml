<Window x:Class="ShopBanHang_OfflineFirst.BarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In Mã Vạch" Height="300" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <StackPanel x:Name="PrintArea" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White">
            <TextBlock x:Name="txtTenSanPham" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <Image x:Name="imgBarcode" Width="200" Height="60" Margin="0,5"/>
            <TextBlock x:Name="txtSKU" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtGiaBan" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="Red"/>
        </StackPanel>

        <Button Content="🖨️ XÁC NHẬN IN TEM" VerticalAlignment="Bottom" Height="40" Background="#198754" Foreground="White" FontWeight="Bold" Click="btnXacNhanIn_Click"/>
    </Grid>
</Window>
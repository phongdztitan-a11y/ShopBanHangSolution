<Window x:Class="ShopBanHang_OfflineFirst.NhapHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NHẬP HÀNG VÀO KHO" Height="542" Width="900" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Danh sách sản phẩm" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="txtTimKiem" Margin="5" Tag="Tìm tên, mã gốc hoặc SKU..." TextChanged="txtTimKiem_TextChanged"/>

                <DataGrid x:Name="dgSanPhamKho" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="5"
                          SelectionChanged="dgSanPhamKho_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SKU" Binding="{Binding SKU}" Width="120"/>
                        <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSanPham}" Width="*"/>
                        <DataGridTextColumn Header="Tồn" Binding="{Binding SoLuongTon}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                    <Button Content="🖨️ In Mã Vạch" Click="btnInMaVach_Click" Background="#0D6EFD" Foreground="White" Width="110" Margin="0,0,10,0"/>
                    <Button x:Name="btnXoa" Content="🗑 Xóa SP" Click="btnXoa_Click" Background="#DC3545" Foreground="White" Width="85"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Column="1" Padding="15">
            <GroupBox.Header>
                <TextBlock x:Name="txtTieuDeForm" Text="2. TẠO SẢN PHẨM MỚI" FontWeight="Bold"/>
            </GroupBox.Header>
            <StackPanel>
                <TextBlock x:Name="txtSkuPreview" Text="" FontSize="11" Foreground="#666" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <TextBlock Text="Tên sản phẩm:" FontWeight="Bold"/>
                <TextBox x:Name="txtNewTen" Margin="0,5,0,10" Height="30" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mã gốc (Ví dụ: AO01):" FontWeight="Bold"/>
                <TextBox x:Name="txtNewMaGoc" Margin="0,5,0,10" Height="30" VerticalContentAlignment="Center"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,5,0">
                        <TextBlock Text="Kích cỡ (S, M...):" FontWeight="Bold"/>
                        <TextBox x:Name="txtNewSize" Height="30" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Màu sắc:" FontWeight="Bold"/>
                        <TextBox x:Name="txtNewMau" Height="30" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Giá Bán:" FontWeight="Bold"/>
                <TextBox x:Name="txtNewGiaBan" Height="30" Margin="0,5,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Tồn kho (chi nhánh hiện tại):" FontWeight="Bold"/>
                <TextBox x:Name="txtNewTon" Margin="0,5,0,16" Height="30" Text="0" VerticalContentAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnThemMo" Grid.Column="0" Content="💾 LƯU SP MỚI" Height="42" FontWeight="Bold"
                            Background="#1877F2" Foreground="White" Margin="0,0,4,0" Click="btnThemMo_Click"/>
                    <Button x:Name="btnSuaSanPham" Grid.Column="1" Content="✏️ SỬA SP" Height="42" FontWeight="Bold"
                            Background="#198754" Foreground="White" Margin="4,0,0,0" Click="btnSuaSanPham_Click" IsEnabled="False"/>
                </Grid>
                <Button x:Name="btnHuyChon" Content="Tạo mới (bỏ chọn)" Height="32" Margin="0,8,0,0" Click="btnHuyChon_Click"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>

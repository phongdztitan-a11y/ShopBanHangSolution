<Window x:Class="ShopBanHang_OfflineFirst.ThemKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THÊM KHÁCH HÀNG MỚI" Height="280" Width="380" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Padding="20" Background="#F8F9FA">
        <StackPanel>
            <TextBlock Text="THÊM KHÁCH HÀNG" FontSize="18" FontWeight="Bold" Foreground="#17A2B8" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Số điện thoại (*):" Margin="0,5,0,2"/>
            <TextBox x:Name="txtSdt" Height="30" VerticalContentAlignment="Center" Padding="5,0" IsReadOnly="True" Background="#E9ECEF"/>

            <TextBlock Text="Họ và tên (*):" Margin="0,10,0,2"/>
            <TextBox x:Name="txtHoTen" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnLuu" Content="LƯU" Grid.Column="0" Margin="0,0,5,0" Height="40" Background="#28A745" Foreground="White" FontWeight="Bold" Click="btnLuu_Click"/>
                <Button x:Name="btnHuy" Content="HỦY" Grid.Column="1" Margin="5,0,0,0" Height="40" Background="#6C757D" Foreground="White" Click="btnHuy_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>